<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_comercial" model="ir.ui.view">
        <field name="name">sale.order.form.samblen.comercial</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="samblen_concretera.view_order_form_concrete"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_compute_freight']" position="replace">
                <button name="action_compute_all" type="object"
                        string="Calcular cargos" invisible="state in ('sale','cancel')"/>
                <button name="action_request_discount_approval" type="object"
                        string="Solicitar aprobación de descuento" class="btn-primary"
                        invisible="not discount_needs_approval or discount_state == 'pending'"/>
                <button name="action_approve_discount" type="object"
                        string="Aprobar descuento" class="btn-success"
                        invisible="discount_state != 'pending'"
                        groups="samblen_comercial.group_discount_approver"/>
                <button name="action_reject_discount" type="object"
                        string="Rechazar descuento"
                        invisible="discount_state != 'pending'"
                        groups="samblen_comercial.group_discount_approver"/>
            </xpath>
            <!-- Datos de obra y concreto en la columna izquierda, bajo el cliente -->
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="samblen_quote_type" widget="radio" options="{'horizontal': true}"
                       string="Cotización de"/>
                <field name="concrete_obra" position="move"/>
                <field name="concrete_zone_id" options="{'no_create': True}"/>
                <field name="concrete_distance_km" position="move"/>
                <field name="concrete_design_id" position="move"/>
                <field name="concrete_tipo" position="move"/>
                <field name="discount_needs_approval" invisible="1"/>
                <field name="discount_state" widget="badge"
                       invisible="discount_state == 'none'"
                       decoration-warning="discount_state == 'pending'"
                       decoration-success="discount_state == 'approved'"
                       decoration-danger="discount_state == 'rejected'"/>
            </xpath>
            <xpath expr="//field[@name='concrete_design_id']" position="attributes">
                <attribute name="invisible">samblen_quote_type == 'prefab'</attribute>
                <attribute name="string">Diseño / resistencia</attribute>
            </xpath>
            <xpath expr="//field[@name='concrete_tipo']" position="attributes">
                <attribute name="invisible">samblen_quote_type == 'prefab'</attribute>
            </xpath>
            <xpath expr="//field[@name='concrete_distance_km']" position="attributes">
                <attribute name="string">Distancia (km)</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Cotizador de concreto" name="samblen_concrete"
                      invisible="samblen_quote_type != 'concrete'">
                    <group>
                        <group string="Especificación técnica">
                            <field name="concrete_tma_option_id" options="{'no_create': True}"/>
                            <field name="concrete_rev_option_id" options="{'no_create': True}"/>
                            <field name="concrete_additive_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="concrete_tiro_id" options="{'no_create': True}"/>
                            <field name="concrete_pump" invisible="concrete_tiro_id"/>
                        </group>
                        <group string="Colado">
                            <field name="concrete_pour_datetime"/>
                            <field name="concrete_pour_hours" widget="float_time"/>
                            <field name="concrete_shift"/>
                            <field name="concrete_wait_minutes"/>
                        </group>
                    </group>
                </page>
                <page string="Prefabricados" name="samblen_prefab"
                      invisible="samblen_quote_type != 'prefab'">
                    <group>
                        <group string="Logística">
                            <field name="prefab_weight_total"/>
                            <field name="prefab_trips"/>
                            <field name="prefab_ready_date"/>
                        </group>
                    </group>
                    <p class="text-muted">Agrega las piezas en Líneas de la orden
                        y pulsa "Calcular cargos": se agrega el flete por viajes
                        y la fecha de entrega según existencias.</p>
                </page>
                <page string="Pago y descuentos" name="samblen_payment">
                    <group>
                        <group>
                            <field name="advance_pct"/>
                            <field name="advance_amount"/>
                        </group>
                        <group>
                            <field name="max_line_discount" string="Descuento mayor (%)"/>
                            <field name="discount_approver_id" invisible="not discount_approver_id"/>
                            <field name="freight_retention"/>
                            <field name="retention_amount" invisible="not freight_retention"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_comercial" model="ir.ui.view">
        <field name="name">sale.order.list.samblen.comercial</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="samblen_quote_type" optional="show"/>
                <field name="concrete_obra" optional="show"/>
                <field name="concrete_pour_datetime" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_search_comercial" model="ir.ui.view">
        <field name="name">sale.order.search.samblen.comercial</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="f_concrete" string="Concreto"
                        domain="[('samblen_quote_type','=','concrete')]"/>
                <filter name="f_prefab" string="Prefabricados"
                        domain="[('samblen_quote_type','=','prefab')]"/>
            </xpath>
        </field>
    </record>
</odoo>
