<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_discount_list" model="ir.ui.view">
        <field name="name">res.users.samblen.discount.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Topes de descuento" editable="bottom" create="false" delete="false">
                <field name="name" readonly="1"/>
                <field name="login" readonly="1"/>
                <field name="samblen_max_discount"/>
            </list>
        </field>
    </record>
    <record id="action_users_discount" model="ir.actions.act_window">
        <field name="name">Topes de descuento</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_users_discount_list"/>
        <field name="domain">[('share', '=', False)]</field>
    </record>
    <menuitem id="menu_users_discount" name="Topes de descuento"
              parent="sale.menu_sale_config" action="action_users_discount"
              sequence="90"/>
</odoo>
