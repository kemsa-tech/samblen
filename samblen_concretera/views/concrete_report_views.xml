<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte Concretera: remisiones (lista + tabla dinamica) -->
    <record id="view_concrete_report_list" model="ir.ui.view">
        <field name="name">concrete.delivery.report.list</field>
        <field name="model">concrete.delivery</field>
        <field name="arch" type="xml">
            <list string="Reporte Concretera" create="false"
                  decoration-danger="out_of_tolerance == True">
                <field name="frumecar_remision"/>
                <field name="date_load"/>
                <field name="order_id"/>
                <field name="vehicle_id"/>
                <field name="operator"/>
                <field name="volume_m3" sum="Total m3"/>
                <field name="deviation_count" string="Desv."/>
                <field name="state" widget="badge" decoration-success="state == 'dosed'"/>
            </list>
        </field>
    </record>

    <record id="view_concrete_report_pivot" model="ir.ui.view">
        <field name="name">concrete.delivery.report.pivot</field>
        <field name="model">concrete.delivery</field>
        <field name="arch" type="xml">
            <pivot string="Reporte Concretera">
                <field name="order_id" type="row"/>
                <field name="volume_m3" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_concrete_report" model="ir.actions.act_window">
        <field name="name">Reporte Concretera</field>
        <field name="res_model">concrete.delivery</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_dosed': 0}</field>
    </record>

    <!-- Consumo de material (para almacen) -->
    <record id="view_concrete_dosage_pivot" model="ir.ui.view">
        <field name="name">concrete.delivery.dosage.pivot</field>
        <field name="model">concrete.delivery.dosage</field>
        <field name="arch" type="xml">
            <pivot string="Consumo de material">
                <field name="material_id" type="row"/>
                <field name="qty_real" type="measure"/>
                <field name="qty_design" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_concrete_dosage_list" model="ir.ui.view">
        <field name="name">concrete.delivery.dosage.list</field>
        <field name="model">concrete.delivery.dosage</field>
        <field name="arch" type="xml">
            <list string="Consumo de material" create="false"
                  decoration-danger="out_of_tolerance == True">
                <field name="order_id"/>
                <field name="delivery_id"/>
                <field name="material_id"/>
                <field name="qty_design" sum="Diseno"/>
                <field name="qty_real" sum="Dosificado"/>
                <field name="deviation"/>
                <field name="uom"/>
            </list>
        </field>
    </record>

    <record id="action_concrete_dosage" model="ir.actions.act_window">
        <field name="name">Consumo de material</field>
        <field name="res_model">concrete.delivery.dosage</field>
        <field name="view_mode">pivot,list,graph</field>
    </record>

    <!-- ===== Tablero de desviaciones (grafico + pivote) ===== -->
    <record id="view_concrete_dosage_graph" model="ir.ui.view">
        <field name="name">concrete.delivery.dosage.graph</field>
        <field name="model">concrete.delivery.dosage</field>
        <field name="arch" type="xml">
            <graph string="Desviaciones" type="bar" sample="1">
                <field name="material_id"/>
                <field name="deviation" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_concrete_dosage_dash_pivot" model="ir.ui.view">
        <field name="name">concrete.delivery.dosage.dash.pivot</field>
        <field name="model">concrete.delivery.dosage</field>
        <field name="arch" type="xml">
            <pivot string="Desviaciones">
                <field name="order_id" type="row"/>
                <field name="material_id" type="col"/>
                <field name="deviation" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_deviation_dashboard" model="ir.actions.act_window">
        <field name="name">Tablero de desviaciones</field>
        <field name="res_model">concrete.delivery.dosage</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_out_of_tolerance': 1}</field>
    </record>

    <record id="view_concrete_dosage_search" model="ir.ui.view">
        <field name="name">concrete.delivery.dosage.search</field>
        <field name="model">concrete.delivery.dosage</field>
        <field name="arch" type="xml">
            <search>
                <field name="material_id"/>
                <field name="order_id"/>
                <filter name="out_of_tolerance" string="Fuera de tolerancia"
                        domain="[('out_of_tolerance','=',True)]"/>
                <separator/>
                <filter name="g_material" string="Material"
                        context="{'group_by':'material_id'}"/>
                <filter name="g_order" string="Orden"
                        context="{'group_by':'order_id'}"/>
            </search>
        </field>
    </record>
</odoo>
