<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_concrete_mix_design_list" model="ir.ui.view">
        <field name="name">concrete.mix.design.list</field>
        <field name="model">concrete.mix.design</field>
        <field name="arch" type="xml">
            <list string="Disenos de mezcla">
                <field name="name"/>
                <field name="resistance"/>
                <field name="tma"/>
                <field name="revenimiento"/>
                <field name="tolerance"/>
                <field name="line_count" string="Materiales"/>
            </list>
        </field>
    </record>

    <record id="view_concrete_mix_design_form" model="ir.ui.view">
        <field name="name">concrete.mix.design.form</field>
        <field name="model">concrete.mix.design</field>
        <field name="arch" type="xml">
            <form string="Diseno de mezcla">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="D-FC250-20"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="resistance"/>
                            <field name="tma"/>
                            <field name="revenimiento"/>
                        </group>
                        <group>
                            <field name="tolerance"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materiales por m3">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="material_id"/>
                                    <field name="qty_per_m3"/>
                                    <field name="uom"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_concrete_mix_design" model="ir.actions.act_window">
        <field name="name">Disenos de mezcla</field>
        <field name="res_model">concrete.mix.design</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
